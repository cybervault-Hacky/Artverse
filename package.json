{
  "name": "artverse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ArtVerse — Where Art Finds Its Universe. Phase 1 foundation of a global art marketplace.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "validate": "npm run typecheck && npm run lint && npm run build && npm run verify:routes",
    "verify:routes": "node scripts/verify-routes.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
